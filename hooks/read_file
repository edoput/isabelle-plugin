#!/usr/bin/env python3

"""
Dump read_file tool output and summarize it. Runs as a PostToolUse hook.
"""

import io
import json
import re
import sys

READ_FILE_JSON = "read_file.json"

def to_cat_n(content: str) -> str:
    with io.StringIO() as out:
        for line in content.splitlines():
            m = re.match(r"^\s*(\d+):(.*)", line)
            if m:
                out.write(f"{int(m.group(1)):>6}\t{m.group(2)}\n")
            else:
                out.write(line + "\n")
        return out.getvalue()

def to_grep(path: str, matches: list) -> str:
    with io.StringIO() as out:
        for i, match in enumerate(matches):
            if i > 0:
                out.write("--\n")
            for line in match["context"].splitlines():
                m = re.match(r"^→ (\d+):(.*)", line)
                if m:
                    out.write(f"{path}:{m.group(1)}:{m.group(2)}\n")
                    continue
                m = re.match(r"^\s+(\d+):(.*)", line)
                if m:
                    out.write(f"{path}-{m.group(1)}-{m.group(2)}\n")
        return out.getvalue()

def summarize(path: str, content: str) -> str:
    return to_cat_n(content)

def main():
    try:
        input_data = json.load(sys.stdin)
    except json.JSONDecodeError as e:
        print(f"Error: Invalid JSON input: {e}", file=sys.stderr)
        sys.exit(0)

    with open(READ_FILE_JSON, "w") as f:
        json.dump(input_data, f, indent=2)

    raw_response = input_data.get("tool_response")
    tool_input = input_data.get("tool_input", {})

    if isinstance(raw_response, str):
        m = re.search(r"saved to ([^\n]+\.txt)", raw_response)
        if not m:
            sys.exit(0)
        with open(m.group(1)) as f:
            text = f.read()
    else:
        text = raw_response[0].get("text", "{}")

    response = json.loads(text)
    path = tool_input.get("path", "")
    mode = tool_input.get("mode", "Line")
    content = response.get("content", "")

    if mode == "Search":
        summary = to_grep(path, content)
    else:
        summary = summarize(path, content)

    out = {
        "hookSpecificOutput": {
            "hookEventName": "PostToolUse",
            "updatedToolOutput": [{"type": "text", "text": summary}],
            "additionalContext": f"Full read_file response saved to {READ_FILE_JSON}",
        }
    }

    json.dump(out, sys.stdout)
    sys.exit(0)

if __name__ == "__main__":
    main()
